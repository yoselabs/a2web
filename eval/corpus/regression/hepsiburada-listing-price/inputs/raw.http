ight\":0.12,\"trackingInfo\":null,\"taxVatRate\":20,\"adsCampaignOwnerType\":\"\",\"isPromoted\":false,\"adsUniqueId\":\"\",\"merchantId\":\"\",\"adsCampaignId\":\"\",\"adsSupplierId\":\"\"},{\"sku\":\"HBCV0000A0QHML\",\"name\":\"Samsung Galaxy Buds3 Fe Gri - SM-R420NZAATUR (Samsung Türkiye Garantili)\",\"url\":\"/samsung-galaxy-buds3-fe-gri-sm-r420nzaatur-samsung-turkiye-garantili-p-HBCV0000A0QHML\",\"isDefault\":false,\"procurable\":true,\"adInfo\":\"\",\"adShowId\":\"\",\"isMultiSeller\":false,\"listing\":{\"priceInfo\":{\"price\":4449.82,\"priceTextColor\":\"\",\"originalPrice\":5199,\"discountRate\":2,\"discountType\":\"Discount\"},\"isPreOrder\":false,\"inStockDate\":null,\"merchantName\":\"\",\"merchantId\":\"\",\"listingId\":\"0709e328-9bf5-4b23-86cb-60b21d4459d3\",\"tagList\":null,\"labels\":null,\"categorizedLabels\":{\"incentiveToBuy\":null,\"valueAddedService\":null,\"campaign\":null,\"winner\":null,\"affordability\":null,\"imageLabel\":null,\"hepsiMoney\":null,\"winnerLabels\":null},\"jetDeliveryCities\":null,\"jetDelivery\":false,\"expressDeliveryWarehouses\":null,\"expressDelivery\":false,\"cityBasedCutOffEnabled\":false,\"campaignText\":\"\",\"campaigns\":null,\"minimumPrice\":0,\"minimumPrices\":null,\"shippingProfileId\":\"\",\"shipmentDay\":0,\"aiBasedShipmentDay\":0,\"warehouseId\":\"\",\"availableWarehouses\":null,\"campaignPriceInfo\":null,\"nextEligibleCampaign\":null},\"images\":[{\"link\":\"https://productimages.hepsiburada.net/s/777/{size}/110001203117605.jpg\",\"isDefault\":true,\"height\":746,\"width\":1033}],\"properties\":{\"Renk\":{\"displayValue\":\"Gri\",\"value\":\"Gri\"}},\"energyClassInfo\":null,\"winnerFreight\":0,\"trackingInfo\":null,\"taxVatRate\":0,\"adsCampaignOwnerType\":\"\",\"isPromoted\":false,\"adsUniqueId\":\"\",\"merchantId\":\"\",\"adsCampaignId\":\"\",\"adsSupplierId\":\"\"}],\"displayOptions\":{\"isAdultProduct\":false,\"hasColorVariant\":true},\"hasVariant\":true,\"userContentInfo\":{\"bestReview\":{\"content\":\"Kalite kendini belli ediyor.\\nSamsung Buds2Pro ve Mi Earbuds Basic 2 kullanıcısı olarak söylemeliyim ki müzik kalitesi Buds2Pro ile aynı; çok net ve pürüzsüz, dinlemesi keyifli ancak derin bası Mi gibi değil. Bas olayını merak ediyordum. Mi'de müzik dinlemeyi Samsung'dan daha çok seviyorum lâkin konuşma konusunda Samsung çok çok daha iyi.\\nBu kulaklığın konuşma kalitesi ise Samsung Buds2 Pro'nun konuşma kalitesinden daha iyi.\\nSamsung telefon kullanmadığımdan mıdır bilmiyorum ses çok yüksek değildi, bilgisayarda ki ses ise yeterliydi. Dışarının sesini duymuyorsun.\\nBilgisayarda video izlerken gecikme hissetmedim.\\nYazılımsal özelliklerini kullanmak için Samsung telefon gerekiyor.\\nKutusundan kablo çıkmıyor, büyük ve küçük olmak üzere kulak içi yedek silikonlar var.\\nHızlı ve sorunsuz gönderim için teşekkür ederim. Ayrıca piyasanın en ucuzu idi.\",\"firstname\":\"Ü\",\"lastname\":\"A\"},\"userContentCountWithMedia\":18},\"isSemantic\":false,\"definition\":{\"id\":372,\"name\":\"Bluetooth Kulaklıklar\"},\"mainCategory\":{\"id\":16218,\"name\":\"Bluetooth Kulaklıklar\"},\"cardSize\":\"M\",\"CardSizePx\":124,\"al_p\":\"t3wAZrH4Vwh/Mys7Y82wvrccYxNlR+bnAkWJiH2CKx4YbGpP+lRZYQXmuhzjYZtGMr49x4B2BbmOebiQ5Px2TywiusnwV+6+i++wDsWYEkibLxDTRPrhPCQv7T/RsIO4UMSdX+U7O/kRO1p+VyUc2g==\",\"isSplitted\":false,\"isMirosProduct\":0,\"reasonDetails\":\"\",\"isExistColorVariant\":true,\"colorVariantCount\":2,\"installmentLimit\":9},{\"productId\":\"HBC00008ZZMKG\",\"brand\":\"Nothing\",\"customerReviewCount\":331,\"customerReviewScore\":5,\"customerReviewRating\":4.5,\"boostingFactors\":[],\"variantList\":[{\"sku\":\"HBCV00008ZZMKH\",\"name\":\"Nothing Cmf Buds 2 Plus - Mavi\",\"url\":\"/nothing-cmf-buds-2-plus-mavi-p-HBCV00008ZZMKH\",\"isDefault\":true,\"procurable\":true,\"adInfo\":\"\",\"adShowId\":\"\",\"isMultiSeller\":false,\"listing\":{\"priceInfo\":{\"price\":2999,\"priceTextColor\":\"\",\"originalPrice\":2999,\"discountRate\":0,\"discountType\":\"NoDiscount\"},\"isPreOrder\":