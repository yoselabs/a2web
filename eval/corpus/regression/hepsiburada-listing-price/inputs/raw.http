:\"\",\"originalPrice\":2099,\"discountRate\":0,\"discountType\":\"NoDiscount\"},\"isPreOrder\":false,\"inStockDate\":null,\"merchantName\":\"\",\"merchantId\":\"\",\"listingId\":\"e782992c-bfe5-4ccc-bd79-f37f31d67ca5\",\"tagList\":null,\"labels\":null,\"categorizedLabels\":{\"incentiveToBuy\":null,\"valueAddedService\":null,\"campaign\":null,\"winner\":null,\"affordability\":null,\"imageLabel\":null,\"hepsiMoney\":null,\"winnerLabels\":null},\"jetDeliveryCities\":null,\"jetDelivery\":false,\"expressDeliveryWarehouses\":null,\"expressDelivery\":false,\"cityBasedCutOffEnabled\":false,\"campaignText\":\"\",\"campaigns\":null,\"minimumPrice\":0,\"minimumPrices\":null,\"shippingProfileId\":\"\",\"shipmentDay\":0,\"aiBasedShipmentDay\":0,\"warehouseId\":\"\",\"availableWarehouses\":null,\"campaignPriceInfo\":null,\"nextEligibleCampaign\":null},\"images\":[{\"link\":\"https://productimages.hepsiburada.net/s/777/{size}/110000903796879.jpg\",\"isDefault\":true,\"height\":1500,\"width\":1118}],\"properties\":{\"Renk\":{\"displayValue\":\"Beyaz\",\"value\":\"Beyaz\"}},\"energyClassInfo\":null,\"winnerFreight\":0,\"trackingInfo\":null,\"taxVatRate\":0,\"adsCampaignOwnerType\":\"\",\"isPromoted\":false,\"adsUniqueId\":\"\",\"merchantId\":\"\",\"adsCampaignId\":\"\",\"adsSupplierId\":\"\"}],\"displayOptions\":{\"isAdultProduct\":false,\"hasColorVariant\":true},\"hasVariant\":true,\"userContentInfo\":{\"bestReview\":{\"content\":\"Kulaklık mükemmel, efsane, üst düzey bir ses kalitesi yapmışlar. Sanki orkestra karşınızda çalıyor. Anc özelliği sayesinde etrafınızdaki seslerden soyutlanıyorsunuz. Şeffaf mod özelliği ilede hem ortam sesini duyabiliyor., hemde kulaklıkla müzik dinlemeye devam ediyorsunuz. Bu kadar beklemiyordum. Telefonunuzda Ldac desteğide varsa Müthiş bir kalite. Tanındık markalara fazla para vermenize hiç gerek yok. Fiyatı artmadan alın aldırın. 1470₺ ye aldım. Sonuna kadar hak ediyor. Şuan bu yorumu okuyup ne alacağına kararsız kalan arkadaşım; 1 aydır tüm markaları araştırdım inceledim bana güven pişman olmayacaksın. \\nSes netliği, yüksekliği, Bass tiz mid hepsi tatminkâr. 6 tane mikrofon var ses karşı tarafa NET gidiyor. Kızılötesi sensör sayesinde kulaktan çıkarınca müzik duruyor. Dokunmatik , parça durdurma,ses kısma, sonraki parça her kulaklık için ayrı ayrı ayarlanıyor. Bütün özellikleri bu kulaklığa koymuşlar. Diğer kulaklıklar da 128kbit müzik dinlerken şuan 980kbit dinliyorum. Buraya kadar okuduysan pişman olmazsın bana güven at sepete bu zamana kadar nelere para vermedik ki :)\\n\\nEdit: 1 ay sonra sol kulaklık patladı. Bass sesleri boğuk gelmeye başladı.\",\"firstname\":\"İ\",\"lastname\":\"G\"},\"userContentCountWithMedia\":143},\"isSemantic\":false,\"definition\":{\"id\":372,\"name\":\"Bluetooth Kulaklıklar\"},\"mainCategory\":{\"id\":16218,\"name\":\"Bluetooth Kulaklıklar\"},\"cardSize\":\"M\",\"CardSizePx\":124,\"al_p\":\"5jbT6cF3R/xOsm+GzrQEd2pqR/yGolJgVcwtsTU6FbBu4ZiW3V3yMhIWGg3b9rgkbFTszlA/WdMlDacyhlF8+IzHtLdzRqoMv/z46assUz2zXqKvDhdFDUvlgWJvJDILlfe/+N9cW/KsV1ENTQBpLnGD8ORQIp7OuoZcWUuhhDM=\",\"isSplitted\":false,\"isMirosProduct\":0,\"reasonDetails\":\"\",\"isExistColorVariant\":true,\"colorVariantCount\":3,\"installmentLimit\":9},{\"productId\":\"HBC0000AHW5WW\",\"brand\":\"JBL\",\"customerReviewCount\":110,\"customerReviewScore\":5,\"customerReviewRating\":4.8,\"boostingFactors\":[],\"variantList\":[{\"sku\":\"HBCV0000AHW5X3\",\"name\":\"Jbl Tune 520BT Siyah Kulak Üstü Bluetooth Kulaklık\",\"url\":\"/jbl-tune-520bt-siyah-kulak-ustu-bluetooth-kulaklik-ithalat-firma-garantili-pm-HBC0000AHW5WW\",\"isDefault\":true,\"procurable\":true,\"adInfo\":\"\",\"adShowId\":\"\",\"isMultiSeller\":true,\"listing\":{\"priceInfo\":{\"price\":1699,\"priceTextColor\":\"\",\"originalPrice\":1699,\"discountRate\":0,\"discountType\":\"NoDiscount\"},\"isPreOrder\":false,\"inStockDate\":null,\"merchantName\":\"Hepsiburada\",\"merchantId\":\"e750130c-d0ff-469f-8767-66a63af8ea0c\",\"listingId\":\"3f758d5b-049c-4f82-913d-c3bd6df1898