tü İptali Modunu istediğşniz gibi seçin. Ses hem doyurucu hem de başınızı ağrıtmayan bir yapıya dönüyor.\\nMalzeme kalitesi kaliteli hissiyatlı, plastiği mat ve tok hissettiriyor.\",\"firstname\":\"M\",\"lastname\":\"Y\"},\"userContentCountWithMedia\":26},\"isSemantic\":false,\"definition\":{\"id\":372,\"name\":\"Bluetooth Kulaklıklar\"},\"mainCategory\":{\"id\":16218,\"name\":\"Bluetooth Kulaklıklar\"},\"cardSize\":\"M\",\"CardSizePx\":124,\"al_p\":\"FlD/3dO8UeYGD1ctG0W7tmAdEpcMYtkZwQJMylx9tTJIdeEuLCBhb8n29m7u5+gMl+Kr43kqdjv7P7Ac89x3R6wa+j2jxcL+6oTapnacFKCVRhuL0YGyfwFuiPZpBlKOpnUAFATmwdqZb9ZBNdY/+mIYdmmeA1BBwRTL8Ve0+vA=\",\"isSplitted\":false,\"isMirosProduct\":0,\"reasonDetails\":\"\",\"isExistColorVariant\":true,\"colorVariantCount\":2,\"installmentLimit\":9},{\"productId\":\"HBC0000BTF697\",\"brand\":\"Xiaomi\",\"customerReviewCount\":562,\"customerReviewScore\":5,\"customerReviewRating\":4.6,\"boostingFactors\":[\"cok-avantajli-fiyatlar\"],\"variantList\":[{\"sku\":\"HBCV0000BTF698\",\"name\":\"Xiaomi Redmi Buds 8 Lite Siyah Kulakiçi Kulaklık Tws - Anc Bt 5.4 (Xiaomi Tr Garantili)\",\"url\":\"/xiaomi-redmi-buds-8-lite-siyah-kulakici-kulaklik-tws-anc-bt-5-4-xiaomi-tr-garantili-p-HBCV0000BTF698\",\"isDefault\":true,\"procurable\":true,\"adInfo\":\"\",\"adShowId\":\"\",\"isMultiSeller\":true,\"listing\":{\"priceInfo\":{\"price\":1298.92,\"priceTextColor\":\"\",\"originalPrice\":1298.92,\"discountRate\":0,\"discountType\":\"NoDiscount\"},\"isPreOrder\":false,\"inStockDate\":null,\"merchantName\":\"Hepsiburada\",\"merchantId\":\"e750130c-d0ff-469f-8767-66a63af8ea0c\",\"listingId\":\"a5b668b2-6b84-4ec9-8b81-654bd3ac3192\",\"tagList\":[{\"tagId\":\"bt-yt-urunleri\",\"tagName\":\"BT/YT Ürünleri\",\"tagGroupName\":\"\",\"startDate\":\"2022-08-01T11:52:20Z\",\"endDate\":\"2029-07-01T20:59:00Z\"}],\"labels\":null,\"categorizedLabels\":{\"incentiveToBuy\":null,\"valueAddedService\":null,\"campaign\":null,\"winner\":null,\"affordability\":null,\"imageLabel\":[{\"tagName\":\