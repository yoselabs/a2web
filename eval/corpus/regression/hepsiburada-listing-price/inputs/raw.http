\":{\"Renk\":{\"displayValue\":\"Siyah\",\"value\":\"Siyah\"}},\"energyClassInfo\":null,\"winnerFreight\":0,\"trackingInfo\":null,\"taxVatRate\":0,\"adsCampaignOwnerType\":\"\",\"isPromoted\":false,\"adsUniqueId\":\"\",\"merchantId\":\"\",\"adsCampaignId\":\"\",\"adsSupplierId\":\"\"}],\"displayOptions\":{\"isAdultProduct\":false,\"hasColorVariant\":true},\"hasVariant\":true,\"userContentInfo\":{\"bestReview\":{\"content\":\"Kargo bir haftada geldi çünkü 4 gün boyunca ürün hazırlandı. Eşimde beyaz var diye ben de siyah sipariş ettim ancak beyaz geldi. Üstelik uygulamasında siyah görünüyor 😂 Haftalar sürüyor o nedenle iadeyle uğraşmayacağım. Daha iyi ses kalitesi olan kulaklık denemedim o nedenle bana göre sesi çok iyi. ANC modu çok sesli ortamda yeterli değil. Şeffaf modu var orta ses seviyesinde iş görüyor yüksek seste etraftaki sesleri duyamıyorum. Uygulamasındaki ekolayzır ayarları güzel. Ara sıra bağlantı kopuyor farkedilmeyebilir. Oyun modu var sadece oyun açıkken gecikme epey azaltılmış ancak yine de yakın savaşlarda üzer. Müzik programı ve oyun aynı anda açıksa gecikme belli ediyor kendini. Bir günlük kullanım sonucunda izlenimlerim bunlar. Şarj konusunda deneyimim yok. Anlayacağınız parasına göre bir cihaz. Faydalı olabildiysem ne mutlu bana.\",\"firstname\":\"Y\",\"lastname\":\"E\"},\"userContentCountWithMedia\":324},\"isSemantic\":false,\"definition\":{\"id\":372,\"name\":\"Bluetooth Kulaklıklar\"},\"mainCategory\":{\"id\":16218,\"name\":\"Bluetooth Kulaklıklar\"},\"cardSize\":\"M\",\"CardSizePx\":124,\"al_p\":\"TvsuGH/V9bTt8pF7J+sHGgioEZNnFU13bsb4P+TxJVvsda39BVUC+8nf7iHfZtrCWnYsUcImi4B2eyrrJnCI6Q36cUsLkEJasi4hD9ZiSLtas3OnJTExA9pLxlX6HmTWHVOcdcEqpj9ixxOeOw02EMdTqEqwThcnHccO6q8FT9g=\",\"isSplitted\":false,\"isMirosProduct\":0,\"reasonDetails\":\"\",\"isExistColorVariant\":true,\"colorVariantCount\":2,\"installmentLimit\":9},{\"productId\":\"HBC00007I7KKK\",\"brand\":\"Huawei\",\"customerReviewCount\":974,\"customerReviewScore\":5,\"customerReviewRating\":4.