ntDay\":0,\"warehouseId\":\"\",\"availableWarehouses\":null,\"campaignPriceInfo\":null,\"nextEligibleCampaign\":null},\"images\":[{\"link\":\"https://productimages.hepsiburada.net/s/396/{size}/110000421499525.jpg\",\"isDefault\":true,\"height\":770,\"width\":485}],\"properties\":{\"Renk\":{\"displayValue\":\"Beyaz\",\"value\":\"Beyaz\"}},\"energyClassInfo\":null,\"winnerFreight\":0,\"trackingInfo\":null,\"taxVatRate\":0,\"adsCampaignOwnerType\":\"\",\"isPromoted\":false,\"adsUniqueId\":\"\",\"merchantId\":\"\",\"adsCampaignId\":\"\",\"adsSupplierId\":\"\"}],\"displayOptions\":{\"isAdultProduct\":false,\"hasColorVariant\":true},\"hasVariant\":true,\"userContentInfo\":{\"bestReview\":{\"content\":\"Kargo bir haftada geldi çünkü 4 gün boyunca ürün hazırlandı. Eşimde beyaz var diye ben de siyah sipariş ettim ancak beyaz geldi. Üstelik uygulamasında siyah görünüyor 😂 Haftalar sürüyor o nedenle iadeyle uğraşmayacağım. Daha iyi ses kalitesi olan kulaklık denemedim o nedenle bana göre sesi çok iyi. ANC modu çok sesli ortamda yeterli değil. Şeffaf modu var orta ses seviyesinde iş görüyor yüksek seste etraftaki sesleri duyamıyorum. Uygulamasındaki ekolayzır ayarları güzel. Ara sıra bağlantı kopuyor farkedilmeyebilir. Oyun modu var sadece oyun açıkken gecikme epey azaltılmış ancak yine de yakın savaşlarda üzer. Müzik programı ve oyun aynı anda açıksa gecikme belli ediyor kendini. Bir günlük kullanım sonucunda izlenimlerim bunlar. Şarj konusunda deneyimim yok. Anlayacağınız parasına göre bir cihaz. Faydalı olabildiysem ne mutlu bana.\",\"firstname\":\"Y\",\"lastname\":\"E\"},\"userContentCountWithMedia\":324},\"isSemantic\":false,\"definition\":{\"id\":372,\"name\":\"Bluetooth Kulaklıklar\"},\"mainCategory\":{\"id\":16218,\"name\":\"Bluetooth Kulaklıklar\"},\"cardSize\":\"M\",\"CardSizePx\":124,\"al_p\":\"JKIQg1QIIIXe/uQI26zQya++D59FIOaLTV+///ILvRfrfgOHW6IowmCnjLA1pU2fuXBl2SnXWhomTdIXtWU4wNNny+dhGvySDX7rQdYKfPf0gtZ7v43EEwOiaxLtUar5iQbHyOcyz9Ut1jKfKiQCwB3kzj1MFf0Z/o6oA1cETqY=\",