"\",\"merchantId\":\"\",\"adsCampaignId\":\"\",\"adsSupplierId\":\"\"},{\"sku\":\"HBCV000047WC9J\",\"name\":\"Qcy T13 ANC 4 Mikrofon Bluetooth 5.3 Kablosuz Kulaklık Beyaz Aktif Gürültü Engelleme\",\"url\":\"/qcy-t13-anc-4-mikrofon-bluetooth-5-3-kablosuz-kulaklik-beyaz-aktif-gurultu-engelleme-p-HBCV000047WC9J\",\"isDefault\":false,\"procurable\":true,\"adInfo\":\"\",\"adShowId\":\"\",\"isMultiSeller\":false,\"listing\":{\"priceInfo\":{\"price\":849,\"priceTextColor\":\"\",\"originalPrice\":849,\"discountRate\":0,\"discountType\":\"NoDiscount\"},\"isPreOrder\":false,\"inStockDate\":null,\"merchantName\":\"\",\"merchantId\":\"\",\"listingId\":\"d8c60284-c6dc-40dd-aea0-191012e1ccbe\",\"tagList\":null,\"labels\":null,\"categorizedLabels\":{\"incentiveToBuy\":null,\"valueAddedService\":null,\"campaign\":null,\"winner\":null,\"affordability\":null,\"imageLabel\":null,\"hepsiMoney\":null,\"winnerLabels\":null},\"jetDeliveryCities\":null,\"jetDelivery\":false,\"expressDeliveryWarehouses\":null,\"expressDelivery\":false,\"cityBasedCutOffEnabled\":false,\"campaignText\":\"\",\"campaigns\":null,\"minimumPrice\":0,\"minimumPrices\":null,\"shippingProfileId\":\"\",\"shipmentDay\":0,\"aiBasedShipmentDay\":0,\"warehouseId\":\"\",\"availableWarehouses\":null,\"campaignPriceInfo\":null,\"nextEligibleCampaign\":null},\"images\":[{\"link\":\"https://productimages.hepsiburada.net/s/396/{size}/110000421499525.jpg\",\"isDefault\":true,\"height\":770,\"width\":485}],\"properties\":{\"Renk\":{\"displayValue\":\"Beyaz\",\"value\":\"Beyaz\"}},\"energyClassInfo\":null,\"winnerFreight\":0,\"trackingInfo\":null,\"taxVatRate\":0,\"adsCampaignOwnerType\":\"\",\"isPromoted\":false,\"adsUniqueId\":\"\",\"merchantId\":\"\",\"adsCampaignId\":\"\",\"adsSupplierId\":\"\"}],\"displayOptions\":{\"isAdultProduct\":false,\"hasColorVariant\":true},\"hasVariant\":true,\"userContentInfo\":{\"bestReview\":{\"content\":\"Kargo bir haftada geldi çünkü 4 gün boyunca ürün hazırlandı. Eşimde beyaz var diye ben de siyah sipariş ettim ancak beyaz geldi. Üstelik uygulamasında siyah görünüyor 😂 Haftalar sürüyor o nedenle iadeyle uğraşmayacağım. Daha iyi ses kalitesi olan kulaklık denemedim o nedenle bana göre sesi çok iyi. ANC modu çok sesli ortamda yeterli değil. Şeffaf modu var orta ses seviyesinde iş görüyor yüksek seste etraftaki sesleri duyamıyorum. Uygulamasındaki ekolayzır ayarları güzel. Ara sıra bağlantı kopuyor farkedilmeyebilir. Oyun modu var sadece oyun açıkken gecikme epey azaltılmış ancak yine de yakın savaşlarda üzer. Müzik programı ve oyun aynı anda açıksa gecikme belli ediyor kendini. Bir günlük kullanım sonucunda izlenimlerim bunlar. Şarj konusunda deneyimim yok. Anlayacağınız parasına göre bir cihaz. Faydalı olabildiysem ne mutlu bana.\",\"firstname\":\"Y\",\"lastname\":\"E\"},\"userContentCountWithMedia\":324},\"isSemantic\":false,\"definition\":{\"id\":372,\"name\":\"Bluetooth Kulaklıklar\"},\"mainCategory\":{\"id\":16218,\"name\":\"Bluetooth Kulaklıklar\"},\"cardSize\":\"M\",\"CardSizePx\":124,\"al_p\":\"JKIQg1QIIIXe/uQI26zQya++D59FIOaLTV+///ILvRfrfgOHW6IowmCnjLA1pU2fuXBl2SnXWhomTdIXtWU4wNNny+dhGvySDX7rQdYKfPf0gtZ7v43EEwOiaxLtUar5iQbHyOcyz9Ut1jKfKiQCwB3kzj1MFf0Z/o6oA1cETqY=\",\"isSplitted\":false,\"isMirosProduct\":0,\"reasonDetails\":\"\",\"isExistColorVariant\":true,\"colorVariantCount\":2,\"installmentLimit\":9},{\"productId\":\"HBC000049D0S4\",\"brand\":\"Anker\",\"customerReviewCount\":20647,\"customerReviewScore\":5,\"customerReviewRating\":4.6,\"boostingFactors\":[\"en-avantajli-fiyatlar\"],\"variantList\":[{\"sku\":\"HBCV000049D0S5\",\"name\":\"Anker Soundcore R50i TWS Bluetooth Kablosuz Kulaklık Siyah - IOS ve Android Uyumlu - A3949 (Anker Türkiye Garantili)\",\"url\":\"/anker-soundcore-r50i-tws-bluetooth-kablosuz-kulaklik-siyah-ios-ve-android-uyumlu-a3949-anker-turkiye-garantili-p-HBCV000049D0S5\",\"isDefault\":true,\"procurable\":true,\"adInfo\":\"\",\"adShowId\":\"\",\"isMultiSeller\":true,\"listing\":{\"priceInfo\":{\"price\":1370.86,\"priceTextC