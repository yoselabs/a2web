ight\":545,\"width\":699},{\"link\":\"https://productimages.hepsiburada.net/s/777/{size}/110001058314457.jpg\",\"isDefault\":false,\"height\":545,\"width\":698},{\"link\":\"https://productimages.hepsiburada.net/s/777/{size}/110001058314458.jpg\",\"isDefault\":false,\"height\":718,\"width\":678}],\"properties\":{\"Renk\":{\"displayValue\":\"Mavi\",\"value\":\"Mavi\"}},\"energyClassInfo\":null,\"winnerFreight\":0.25,\"trackingInfo\":null,\"taxVatRate\":20,\"adsCampaignOwnerType\":\"\",\"isPromoted\":false,\"adsUniqueId\":\"\",\"merchantId\":\"\",\"adsCampaignId\":\"\",\"adsSupplierId\":\"\"},{\"sku\":\"HBCV0000BU38RL\",\"name\":\"Nothing Cmf Buds 2 Plus Beyaz\",\"url\":\"/nothing-cmf-buds-2-plus-beyaz-p-HBCV0000BU38RL\",\"isDefault\":false,\"procurable\":true,\"adInfo\":\"\",\"adShowId\":\"\",\"isMultiSeller\":false,\"listing\":{\"priceInfo\":{\"price\":1999,\"priceTextColor\":\"\",\"originalPrice\":1999,\"discountRate\":0,\"discountType\":\"NoDiscount\"},\"isPreOrder\":false,\"inStockDate\":null,\"merchantName\":\"\",\"merchantId\":\"\",\"listingId\":\"9b9adb63-966d-4399-8ed4-67d37ad7cddf\",\"tagList\":null,\"labels\":null,\"categorizedLabels\":{\"incentiveToBuy\":null,\"valueAddedService\":null,\"campaign\":null,\"winner\":null,\"affordability\":null,\"imageLabel\":null,\"hepsiMoney\":null,\"winnerLabels\":null},\"jetDeliveryCities\":null,\"jetDelivery\":false,\"expressDeliveryWarehouses\":null,\"expressDelivery\":false,\"cityBasedCutOffEnabled\":false,\"campaignText\":\"\",\"campaigns\":null,\"minimumPrice\":0,\"minimumPrices\":null,\"shippingProfileId\":\"\",\"shipmentDay\":0,\"aiBasedShipmentDay\":0,\"warehouseId\":\"\",\"availableWarehouses\":null,\"campaignPriceInfo\":null,\"nextEligibleCampaign\":null},\"images\":[{\"link\":\"https://productimages.hepsiburada.net/s/777/{size}/110001405821517.jpg\",\"isDefault\":true,\"height\":563,\"width\":563}],\"properties\":{\"Renk\":{\"displayValue\":\"Beyaz\",\"value\":\"Beyaz\"}},\"energyClassInfo\":null,\"winnerFreight\":0,\"trackingInfo\":null,\"taxVatRate\":0,\"adsCampaignOwnerType\":\"\",\"isPromoted\":false,\"adsUniqueId\":\"\",\"merchantId\":\"\",\"adsCampaignId\":\"\",\"adsSupplierId\":\"\"}],\"displayOptions\":{\"isAdultProduct\":false,\"hasColorVariant\":true},\"hasVariant\":true,\"userContentInfo\":{\"bestReview\":{\"content\":\"Kulak algılama şarkıyı rastgele durdurabiliyor, devre dışı bırakın derim. Yedek silikonlar karton kutuda, dikkatli bakın. Audeze Maxwell kulaklığım için The Odyofil YouTube kanalında önerilen EQ ayarına benzer ses karakteristiği için ( karanlık hissiyatlı, yumuşak baslı, midleri boğmayan ve tiz aşırı çınlatmadan yormayan) yapmanız gereken:\\nKulaklık bağlı iken hem telefondan hem de kulaklığın yazılımından Ldac'ı açın. Uzamsal ses kapalı. Ultra bass kapalı. Düşük gecikme modu kapalı.\\nSonra Kişisel Ses Profili'ni yapın ve açık kalsın.\\nEkolayzer Özel seçip bass: +3, orta: -4, tiz: -6 yapın.\\nGürültü İptali Modunu istediğşniz gibi seçin. Ses hem doyurucu hem de başınızı ağrıtmayan bir yapıya dönüyor.\\nMalzeme kalitesi kaliteli hissiyatlı, plastiği mat ve tok hissettiriyor.\",\"firstname\":\"M\",\"lastname\":\"Y\"},\"userContentCountWithMedia\":26},\"isSemantic\":false,\"definition\":{\"id\":372,\"name\":\"Bluetooth Kulaklıklar\"},\"mainCategory\":{\"id\":16218,\"name\":\"Bluetooth Kulaklıklar\"},\"cardSize\":\"L\",\"CardSizePx\":144,\"al_p\":\"bZnDIOcioJcRSu3nkbokYhxasHiQ3Ph4EjkrXOLGLjO7KbmtKfkkTBpMfKmTB75TD74D2gomo02TlgqJp9O4U+etdt8uK06TKvQlVE+X2xv8QDS/n9tpj0nskDv8hDDAIewjijHhugTszkVkshSanY+vm4NvfL8tPTrXcs6uqzA=\",\"isSplitted\":false,\"isMirosProduct\":0,\"reasonDetails\":\"\",\"isExistColorVariant\":true,\"colorVariantCount\":2,\"installmentLimit\":9},{\"productId\":\"HBC0000D9HUR2\",\"brand\":\"Xiaomi\",\"customerReviewCount\":183,\"customerReviewScore\":5,\"customerReviewRating\":4.5,\"boostingFactors\":[\"en-avantajli-fiyatlar\"],\"variantList\":[{\"sku\":\"HBCV0000D9HUR3\",\"name\":\"Xiaomi Redmi Buds 8 Active Tws Kulak Içi Bluetooth Ku