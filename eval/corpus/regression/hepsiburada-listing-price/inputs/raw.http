nergyClassInfo\":null,\"winnerFreight\":0,\"trackingInfo\":null,\"taxVatRate\":0,\"adsCampaignOwnerType\":\"\",\"isPromoted\":false,\"adsUniqueId\":\"\",\"merchantId\":\"\",\"adsCampaignId\":\"\",\"adsSupplierId\":\"\"},{\"sku\":\"HBCV000072PXK3\",\"name\":\"Redmi Buds 6 Play - Siyah Kulakiçi Kulaklık TWS (Xiaomi Türkiye Garantili)\",\"url\":\"/redmi-buds-6-play-siyah-kulakici-kulaklik-tws-xiaomi-turkiye-garantili-p-HBCV000072PXK3\",\"isDefault\":false,\"procurable\":true,\"adInfo\":\"\",\"adShowId\":\"\",\"isMultiSeller\":false,\"listing\":{\"priceInfo\":{\"price\":709,\"priceTextColor\":\"\",\"originalPrice\":709,\"discountRate\":11,\"discountType\":\"Discount\"},\"isPreOrder\":false,\"inStockDate\":null,\"merchantName\":\"\",\"merchantId\":\"\",\"listingId\":\"bd064186-079c-460e-9651-0dd0f589959d\",\"tagList\":null,\"labels\":null,\"categorizedLabels\":{\"incentiveToBuy\":null,\"valueAddedService\":null,\"campaign\":null,\"winner\":null,\"affordability\":null,\"imageLabel\":null,\"hepsiMoney\":null,\"winnerLabels\":null},\"jetDeliveryCities\":null,\"jetDelivery\":false,\"expressDeliveryWarehouses\":null,\"expressDelivery\":false,\"cityBasedCutOffEnabled\":false,\"campaignText\":\"\",\"campaigns\":null,\"minimumPrice\":0,\"minimumPrices\":null,\"shippingProfileId\":\"\",\"shipmentDay\":0,\"aiBasedShipmentDay\":0,\"warehouseId\":\"\",\"availableWarehouses\":null,\"campaignPriceInfo\":null,\"nextEligibleCampaign\":null},\"images\":[{\"link\":\"https://productimages.hepsiburada.net/s/777/{size}/110000792817673.jpg\",\"isDefault\":true,\"height\":391,\"width\":318}],\"properties\":{\"Renk\":{\"displayValue\":\"Siyah\",\"value\":\"Siyah\"}},\"energyClassInfo\":null,\"winnerFreight\":0,\"trackingInfo\":null,\"taxVatRate\":0,\"adsCampaignOwnerType\":\"\",\"isPromoted\":false,\"adsUniqueId\":\"\",\"merchantId\":\"\",\"adsCampaignId\":\"\",\"adsSupplierId\":\"\"}],\"displayOptions\":{\"isAdultProduct\":false,\"hasColorVariant\":true},\"hasVariant\":true,\"userContentInfo\":{\"bestReview\":{\"content\":\"5 yıldız verme sebebim üstte görünmesi içindir. Ürünü daha önce bilinen markaların orta-iyi seviye kulaklıklarını kullananlar beğenmeyecektir. Oppo enco buds 2 nin yanına yedek olarak aldım opponun tasarımını sevmiyorum ve daha kompakt bir kulak içi kulaklık aradığım için bunu gözüme kestirdim. Şimdi fiyat farkı neredeyse 2 katı fark var ama yine de önerim 2 katını verin kaliteli olsun zaten bir kere alıp uzun süre kullanacaksınız. Öncelikle bariz olarak ses şiddeti düşük, ikinci olarak bassları yoğun değil bass iyileştirme modunda dahi, üçüncü olarak ses kalitesi kötü değil ama iyi asla diyemem. Daha önce Xiaomi earbuds 2 kullanıyordum inanılmaz bir bass ve ses kalitesi vardı, bu daha yeni ve ne kadar kötü olabilir ki diye düşündüm gayet kötü olabilirmiş :) . Çok bir beklentiniz yoksa uygun fiyatı var evet ama gerçekten müzik dinlemek istiyorsanız almayın derim. Yasal olarak iade edemediğimden bu yorumu yapıyorum yedekte tutacağım, tasarım olarak beğenmesem dahi hep oppoyu kullanacağım gibi görünüyor. Not: ürün değerlendirmesine ek olarak CarrefourSA neden ürünün yapışkanı açılmış olarak geldi bilmiyorum yetkililer görüyorsa söylüyorum içinde neyi kontrol ettiniz acaba ürünü açıp bakma sebebiniz nedir? Herhangi bir kullanılmışlık belirtisi göremedim ama yapışkanı açık görünce hoşuma gitmedi.\",\"firstname\":\"M\",\"lastname\":\"K\"},\"userContentCountWithMedia\":397},\"isSemantic\":false,\"definition\":{\"id\":372,\"name\":\"Bluetooth Kulaklıklar\"},\"mainCategory\":{\"id\":16218,\"name\":\"Bluetooth Kulaklıklar\"},\"cardSize\":\"M\",\"CardSizePx\":124,\"al_p\":\"cUExNg8aERvaXh9/XX7VDj9y0JmWYiMqJnRVp1T7w/dgDTjbsmaLvajbXyDAQY5/CuEwY4a/fulhvrrCRA94pK1pSdnFLECa32sEHogCE+ZbCymalUp+Ss4c+6KxWQcWjYLnVpbPEOWFzd7vtItYKAVFQL9wpcGAqddILrn9Ud0=\",\"isSplitted\":false,\"isMirosProduct\":0,\"reasonDetails\":\"\",\"isExistColorVariant\":true,\"colorVariantCount\":4,\"installmentLimit\":9},{\"productId\":\"HBC00004SANT7\",\"brand\":\"Huawei\",\"cust