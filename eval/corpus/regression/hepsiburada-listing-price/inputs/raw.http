":{\"incentiveToBuy\":null,\"valueAddedService\":null,\"campaign\":null,\"winner\":null,\"affordability\":null,\"imageLabel\":null,\"hepsiMoney\":null,\"winnerLabels\":null},\"jetDeliveryCities\":null,\"jetDelivery\":false,\"expressDeliveryWarehouses\":null,\"expressDelivery\":false,\"cityBasedCutOffEnabled\":false,\"campaignText\":\"\",\"campaigns\":null,\"minimumPrice\":0,\"minimumPrices\":null,\"shippingProfileId\":\"\",\"shipmentDay\":0,\"aiBasedShipmentDay\":0,\"warehouseId\":\"\",\"availableWarehouses\":null,\"campaignPriceInfo\":null,\"nextEligibleCampaign\":null},\"images\":[{\"link\":\"https://productimages.hepsiburada.net/s/777/{size}/110000817682787.jpg\",\"isDefault\":true,\"height\":645,\"width\":532}],\"properties\":{\"Renk\":{\"displayValue\":\"Mavi\",\"value\":\"Mavi\"}},\"energyClassInfo\":null,\"winnerFreight\":0,\"trackingInfo\":null,\"taxVatRate\":0,\"adsCampaignOwnerType\":\"\",\"isPromoted\":false,\"adsUniqueId\":\"\",\"merchantId\":\"\",\"adsCampaignId\":\"\",\"adsSupplierId\":\"\"},{\"sku\":\"HBCV000072PXK5\",\"name\":\"Redmi Buds 6 Play - Beyaz Kulakiçi Kulaklık TWS (Xiaomi Türkiye Garantili)\",\"url\":\"/redmi-buds-6-play-beyaz-kulakici-kulaklik-tws-xiaomi-turkiye-garantili-p-HBCV000072PXK5\",\"isDefault\":false,\"procurable\":true,\"adInfo\":\"\",\"adShowId\":\"\",\"isMultiSeller\":false,\"listing\":{\"priceInfo\":{\"price\":799,\"priceTextColor\":\"\",\"originalPrice\":799,\"discountRate\":0,\"discountType\":\"NoDiscount\"},\"isPreOrder\":false,\"inStockDate\":null,\"merchantName\":\"\",\"merchantId\":\"\",\"listingId\":\"e84804d1-c1a9-47c3-80f3-ff1c4293d2dc\",\"tagList\":null,\"labels\":null,\"categorizedLabels\":{\"incentiveToBuy\":null,\"valueAddedService\":null,\"campaign\":null,\"winner\":null,\"affordability\":null,\"imageLabel\":null,\"hepsiMoney\":null,\"winnerLabels\":null},\"jetDeliveryCities\":null,\"jetDelivery\":false,\"expressDeliveryWarehouses\":null,\"expressDelivery\":false,\"cityBasedCutOffEnabled\":false,\"campaignText\":\"\",\"campaigns\":null,\"minimumPrice\":0,\"minimumPrices\":null,\"shippingProfileId\":\"\",\"shipmentDay\":0,\"aiBasedShipmentDay\":0,\"warehouseId\":\"\",\"availableWarehouses\":null,\"campaignPriceInfo\":null,\"nextEligibleCampaign\":null},\"images\":[{\"link\":\"https://productimages.hepsiburada.net/s/777/{size}/110000792964462.jpg\",\"isDefault\":true,\"height\":389,\"width\":314}],\"properties\":{\"Renk\":{\"displayValue\":\"Beyaz\",\"value\":\"Beyaz\"}},\"energyClassInfo\":null,\"winnerFreight\":0,\"trackingInfo\":null,\"taxVatRate\":0,\"adsCampaignOwnerType\":\"\",\"isPromoted\":false,\"adsUniqueId\":\"\",\"merchantId\":\"\",\"adsCampaignId\":\"\",\"adsSupplierId\":\"\"}],\"displayOptions\":{\"isAdultProduct\":false,\"hasColorVariant\":true},\"hasVariant\":true,\"userContentInfo\":{\"bestReview\":{\"content\":\"5 yıldız verme sebebim üstte görünmesi içindir. Ürünü daha önce bilinen markaların orta-iyi seviye kulaklıklarını kullananlar beğenmeyecektir. Oppo enco buds 2 nin yanına yedek olarak aldım opponun tasarımını sevmiyorum ve daha kompakt bir kulak içi kulaklık aradığım için bunu gözüme kestirdim. Şimdi fiyat farkı neredeyse 2 katı fark var ama yine de önerim 2 katını verin kaliteli olsun zaten bir kere alıp uzun süre kullanacaksınız. Öncelikle bariz olarak ses şiddeti düşük, ikinci olarak bassları yoğun değil bass iyileştirme modunda dahi, üçüncü olarak ses kalitesi kötü değil ama iyi asla diyemem. Daha önce Xiaomi earbuds 2 kullanıyordum inanılmaz bir bass ve ses kalitesi vardı, bu daha yeni ve ne kadar kötü olabilir ki diye düşündüm gayet kötü olabilirmiş :) . Çok bir beklentiniz yoksa uygun fiyatı var evet ama gerçekten müzik dinlemek istiyorsanız almayın derim. Yasal olarak iade edemediğimden bu yorumu yapıyorum yedekte tutacağım, tasarım olarak beğenmesem dahi hep oppoyu kullanacağım gibi görünüyor. Not: ürün değerlendirmesine ek olarak CarrefourSA neden ürünün yapışkanı açılmış olarak geldi bilmiyorum yetkililer görüyorsa söylüyorum içinde neyi kontrol ettiniz acaba ürünü açıp bakma sebebiniz nedir? Herhangi bir kullanılmışlık belirtisi göremedim ama yapışkanı açık görünce hoşuma gitmedi.\",\"firstname\":\"M\",\"lastname\":\"K\"},\"userContentCountWithMedia\":397},\"isSemantic\":false,\"definition\":{\"id\":372,\"name\":\"Bluetooth Kulaklıklar\"},\"mainCategory\":{\"id\":16218,\"name\":\"Bluetooth Kulaklıklar\"},\"cardSize\":\"M\",\"CardSizePx\":104,\"al_p\":\"pXpJa9j92QWZ+cRJvQfCpU4h2FNODav2M+o8WVlsY6QZ+ALkePHoD09Xn+bnjAZEQzflmj/sn3m1TZZezpCI/N+xeP4I2IRT8TViXPZ1ybdURkHLQyxRZHEiCR4rNqaVMCuyAJRum/rb8f51kU8PpaNbfdYhVfzYBze94tDb/wk=\",\"isSplitted\":false,\"isMirosProduct\":0,\"reasonDetails\":\"\",\"isExistColorVariant\":true,\"colorVariantCount\":4,\"installmentLimit\":9},{\"productId\":\"HBC00007BZNDY\",\"brand\":\"Xiaomi\",\"customerReviewCount\":7692,\"customerReviewScore\":4,\"customerReviewRating\":4.4,\"boostingFactors\":[\"cok-avantajli-fiyatlar\"],\"variantList\":[{\"sku\":\"HBCV00007BZNDZ\",\"name\":\"Redmi Buds 6 Play Mavi Bluetooth Kulaklık - Suya ve Tere Dayanıklı, Aktif Gürültü Önleme Özellikli\",\"url\":\"/redmi-buds-6-play-mavi-bluetooth-kulaklik-suya-ve-tere-dayanikli-aktif-gurultu-onleme-ozellikli-p-HBCV00007BZNDZ\",\"isDefault\":true,\"procurable\":true,\"adInfo\":\"\",\"adShowId\":\"\",\"isMultiSeller\":true,\"listing\":{\"priceInfo\":{\"price\":709,\"priceTextColor\":\"\",\"originalPrice\":709,\"discountRate\":0,\"discountType\":\"NoDiscount\"},\"isPreOrder\":false,\"inStockDate\":null,\"merchantName\":\"VATAN BİLGİSAYAR\",\"merchantId\":\"e82ae592-6ae6-4d89-85f2-f82137421f36\",\"listingId\":\"78ba5080-86c0-4852-b3c3-bdc732b6601c\",\"tagList\":null,\"labels\":null,\"categorizedLabels\":{\"incentiveToBuy\":null,\"valueAddedService\":null,\"campaign\":null,\"winner\":null,\"affordability\":null,\"imageLabel\":[{\"tagName\":\"en-avantajli-fiyatlar\",\"textColor\":\"\",\"imageUrl\":\"https://images.hepsiburada.net/banners/s/1/104-105/app134056176801991801.png\",\"badgeImageUrl\":\"https://i