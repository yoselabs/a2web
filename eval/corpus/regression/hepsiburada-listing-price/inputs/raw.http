18.jpg\",\"isDefault\":false,\"height\":706,\"width\":651},{\"link\":\"https://productimages.hepsiburada.net/s/777/{size}/110001405821519.jpg\",\"isDefault\":false,\"height\":543,\"width\":699},{\"link\":\"https://productimages.hepsiburada.net/s/777/{size}/110001405821520.jpg\",\"isDefault\":false,\"height\":540,\"width\":696}],\"properties\":{\"Renk\":{\"displayValue\":\"Beyaz\",\"value\":\"Beyaz\"}},\"energyClassInfo\":null,\"winnerFreight\":0.12,\"trackingInfo\":null,\"taxVatRate\":20,\"adsCampaignOwnerType\":\"\",\"isPromoted\":false,\"adsUniqueId\":\"\",\"merchantId\":\"\",\"adsCampaignId\":\"\",\"adsSupplierId\":\"\"},{\"sku\":\"HBCV00008ZZMKH\",\"name\":\"Nothing Cmf Buds 2 Plus - Mavi\",\"url\":\"/nothing-cmf-buds-2-plus-mavi-p-HBCV00008ZZMKH\",\"isDefault\":false,\"procurable\":true,\"adInfo\":\"\",\"adShowId\":\"\",\"isMultiSeller\":false,\"listing\":{\"priceInfo\":{\"price\":2999,\"priceTextColor\":\"\",\"originalPrice\":2999,\"discountRate\":0,\"discountType\":\"NoDiscount\"},\"isPreOrder\":false,\"inStockDate\":null,\"merchantName\":\"\",\"merchantId\":\"\",\"listingId\":\"b475dcfc-6490-4b67-b551-71146e4bcfab\",\"tagList\":null,\"labels\":null,\"categorizedLabels\":{\"incentiveToBuy\":null,\"valueAddedService\":null,\"campaign\":null,\"winner\":null,\"affordability\":null,\"imageLabel\":null,\"hepsiMoney\":null,\"winnerLabels\":null},\"jetDeliveryCities\":null,\"jetDelivery\":false,\"expressDeliveryWarehouses\":null,\"expressDelivery\":false,\"cityBasedCutOffEnabled\":false,\"campaignText\":\"\",\"campaigns\":null,\"minimumPrice\":0,\"minimumPrices\":null,\"shippingProfileId\":\"\",\"shipmentDay\":0,\"aiBasedShipmentDay\":0,\"warehouseId\":\"\",\"availableWarehouses\":null,\"campaignPriceInfo\":null,\"nextEligibleCampaign\":null},\"images\":[{\"link\":\"https://productimages.hepsiburada.net/s/777/{size}/110001058314455.jpg\",\"isDefault\":true,\"height\":563,\"width\":562}],\"properties\":{\"Renk\":{\"displayValue\":\"Mavi\",\"value\":\"Mavi\"}},\"energ